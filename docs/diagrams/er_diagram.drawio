        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK &lt;/b&gt;= primary key, &lt;b&gt;FK &lt;/b&gt;= foreign key&lt;br&gt;&lt;b&gt;Solid line&lt;/b&gt; = foreign key (many → one)&lt;br&gt;&lt;b&gt;Dashed line&lt;/b&gt; = logical join (no FK column)&lt;br&gt;&lt;b&gt;Types &lt;/b&gt;= RAW/Silver types" style="text;html=1;align=left;verticalAlign=top;spacing=8;strokeColor=#0F8B8D;fillColor=#FAE5C7;rounded=1;fontSize=12;fontColor=#143642;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="300" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
